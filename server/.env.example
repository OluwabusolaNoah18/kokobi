# Copy this file to .env and fill it in. NEVER commit .env or share these values.

PORT=4000

# Where order emails are delivered
ORDER_TO=kokobifoods@gmail.com

# Website address(es) allowed to call this API, comma separated, no trailing slash.
# Local dev: http://localhost:5173
# Production example: https://kokobi.vercel.app,https://www.kokobi.com
CORS_ORIGINS=http://localhost:5173

# ---- Option 1: Gmail SMTP (works locally and on hosts that allow SMTP) ----
# Use the Gmail account that will SEND the emails (can be kokobifoods@gmail.com itself).
# SMTP_PASS must be a Google "App Password" (needs 2-Step Verification), NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kokobifoods@gmail.com
SMTP_PASS=

# ---- Option 2: Resend (HTTPS email API; use this if your host blocks SMTP, e.g. Render free tier) ----
# If RESEND_API_KEY is set it is used instead of SMTP.
# On the free plan without a verified domain you can only send to the email you signed up to
# Resend with, so sign up with kokobifoods@gmail.com. Leave RESEND_FROM as is until you verify a domain.
RESEND_API_KEY=
RESEND_FROM=Kokobi+ Orders <onboarding@resend.dev>

# ---- Paystack (online card / bank transfer / USSD checkout) ----
# Get your keys at https://dashboard.paystack.com/#/settings/developers
# Start with the TEST secret key (sk_test_...). Switch to the LIVE key (sk_live_...) once Paystack approves your business.
# Keep this server-side only. Never put it in the client folder.
PAYSTACK_SECRET_KEY=

# The website address, used to send customers back after paying. No trailing slash.
# Local dev: http://localhost:5173     Production: https://your-site.vercel.app
CLIENT_URL=http://localhost:5173

# WhatsApp number (digits only, with country code) shown to customers in their receipt email
WHATSAPP_NUMBER=2347048779681

# Online payments: the customer pays Paystack's fee (1.5% + NGN 100, capped at NGN 2,000) on top of the items.
# Set to false if you would rather absorb the fee yourself. If you change this, also set VITE_PASS_PAYSTACK_FEE
# to the same value in the client so the website shows the right amount.
PASS_PAYSTACK_FEE=true
