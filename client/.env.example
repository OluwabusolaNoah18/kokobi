# Leave empty for local development (Vite proxies /api to localhost:4000).
# In production set this to your deployed backend URL, with no trailing slash.
# Example: VITE_API_URL=https://kokobi-api.onrender.com
VITE_API_URL=

# Online (Paystack) payments: the customer pays Paystack's processing fee on top of the items.
# Set to false ONLY if you also set PASS_PAYSTACK_FEE=false on the server (they must match).
VITE_PASS_PAYSTACK_FEE=true
